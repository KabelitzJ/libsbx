@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

list(APPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")

find_dependency(fmt)
find_dependency(glfw3)
find_dependency(Nethost MODULE)
find_dependency(nlohmann_json)
find_dependency(slang MODULE)
find_dependency(spdlog)
find_dependency(Tracy)
find_dependency(Vulkan MODULE)
find_dependency(VulkanMemoryAllocator)

include("${CMAKE_CURRENT_LIST_DIR}/libsbxTargets.cmake")

check_required_components(libsbx)
